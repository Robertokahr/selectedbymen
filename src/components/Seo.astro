---
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  nofollow = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const og = image ?? new URL('/og.jpg', site.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  (noindex || nofollow) && (
    <meta
      name="robots"
      content={[noindex && 'noindex', nofollow && 'nofollow'].filter(Boolean).join(', ')}
    />
  )
}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:locale" content={site.locale} />
{publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

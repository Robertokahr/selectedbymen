---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from './CategoryBadge.astro';
import { formatDate, readingTime } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const minutes = readingTime(post.body ?? '');
---

<article class:list={['group', featured && 'md:grid md:grid-cols-2 md:gap-8']}>
  <a href={`/blog/${post.id}/`} class="block overflow-hidden border border-gold/15 bg-forest">
    <img
      src={post.data.heroImage}
      alt={post.data.heroAlt}
      width="1080"
      height="608"
      class:list={[
        'h-56 w-full object-cover transition duration-500 group-hover:scale-[1.03]',
        featured && 'md:h-full md:min-h-[22rem]',
      ]}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class:list={['pt-5', featured && 'md:flex md:flex-col md:justify-center md:pt-0']}>
    <div class="flex flex-wrap items-center gap-3">
      <CategoryBadge slug={post.data.category} />
      <time class="text-xs text-muted" datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      <span class="text-xs text-muted">{minutes}</span>
    </div>
    <h3 class:list={['mt-3 font-serif font-medium tracking-tight text-ink', featured ? 'text-3xl md:text-4xl' : 'text-2xl']}>
      <a href={`/blog/${post.id}/`} class="hover:text-gold">{post.data.title}</a>
    </h3>
    <p class:list={['mt-3 text-sm leading-relaxed text-ink-soft', featured && 'md:text-base']}>
      {post.data.description}
    </p>
    <a
      href={`/blog/${post.id}/`}
      class="mt-4 inline-flex text-[11px] font-medium uppercase tracking-[0.18em] text-gold hover:text-cream"
    >
      Read the guide →
    </a>
  </div>
</article>

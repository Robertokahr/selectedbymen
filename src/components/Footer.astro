---
import { site } from '../data/site';
import { categories } from '../data/categories';
import Logo from './Logo.astro';
---

<footer class="border-t border-gold/15 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo variant="lockup" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">
          Independent recommendations for men. We choose products we would buy
          ourselves — then we tell you why.
        </p>
        <p class="mt-4 text-sm text-muted">
          <a class="hover:text-gold" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-gold">
          Explore
        </p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-ink-soft hover:text-gold" href="/blog/">All recommendations</a></li>
          <li><a class="text-ink-soft hover:text-gold" href="/about/">About</a></li>
          <li><a class="text-ink-soft hover:text-gold" href="/contact/">Contact</a></li>
          <li><a class="text-ink-soft hover:text-gold" href="/rss.xml">RSS</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-gold">
          Categories
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-2.5 text-sm">
          {
            categories.map((category) => (
              <li>
                <a class="text-ink-soft hover:text-gold" href={`/category/${category.slug}/`}>
                  {category.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-gold/15 pt-8">
      <p class="max-w-3xl text-xs leading-relaxed text-muted">
        Product links go to Amazon. Prices and availability are accurate as of
        the date of publication and may change.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
        <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
        <p class="tracking-[0.18em] uppercase">Made for men who prefer fewer, better things.</p>
      </div>
    </div>
  </div>
</footer>

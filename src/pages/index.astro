---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PostCard from '../components/PostCard.astro';
import { categories } from '../data/categories';
import { site } from '../data/site';
import { getFeaturedPosts, getPublishedPosts } from '../lib/posts';
import heroImage from '../assets/hero.jpg';

const featured = await getFeaturedPosts();
const latest = (await getPublishedPosts()).slice(0, 3);
const lead = featured[0] ?? latest[0];
const rest = latest.filter((post) => post.id !== lead?.id).slice(0, 2);

const reasons = [
  {
    title: 'We edit, we do not dump.',
    body: 'Every recommendation has to earn its place. If a product is average, it does not make the list — no matter how well it converts.',
  },
  {
    title: 'Criteria you can check.',
    body: 'We look at materials, real-world reviews, return policies, and whether the thing will still feel right a year from now.',
  },
  {
    title: 'Clear about the money.',
    body: 'Nobody buys a ranking here. If we would not buy it ourselves, we will not send you there.',
  },
];
---

<BaseLayout title={site.homeTitle} description={site.description}>
  <section class="mx-auto max-w-6xl px-5 pb-8 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">Product recommendations for men</p>
    <h1 class="mt-5 max-w-4xl font-serif text-5xl font-medium leading-[0.95] tracking-tight text-ink sm:text-7xl">
      Buy fewer things.<br />Own better ones.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      Honest Amazon picks, comparisons, and buying guides — a grooming routine,
      a capsule wardrobe, everyday carry tech, plus fitness, home, and daily
      life. For men who would rather get it right the first time.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href="/blog/" class="btn btn-primary">
        Browse recommendations
      </a>
      <a href="/about/" class="btn btn-ghost">
        How we choose
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="relative overflow-hidden border border-gold/20">
      <Image
        src={heroImage}
        alt="A still life of selected objects for men: a razor, a watch, a notebook, and a folded shirt on walnut."
        widths={[720, 1080, 1600]}
        sizes="(min-width: 1152px) 1120px, 100vw"
        class="aspect-[16/9] w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
      <p class="absolute inset-x-4 bottom-8 text-center font-serif text-2xl font-medium tracking-[0.22em] text-cream sm:inset-x-0 sm:bottom-12 sm:text-5xl sm:tracking-[0.35em] md:text-6xl">
        Quiet luxury
      </p>
    </div>
  </section>

  <section class="border-y border-gold/15 bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Browse by taste</p>
          <h2 class="mt-3 font-serif text-4xl font-medium tracking-tight text-ink">Categories</h2>
        </div>
        <a href="/blog/" class="hidden text-[11px] font-medium uppercase tracking-[0.18em] text-gold hover:text-cream sm:inline">
          All recommendations →
        </a>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <p class="eyebrow">Start here</p>
    <h2 class="mt-3 font-serif text-4xl font-medium tracking-tight text-ink">Featured picks</h2>
    <div class="mt-10 space-y-12">
      {lead && <PostCard post={lead} featured />}
      {
        rest.length > 0 && (
          <div class="grid gap-10 md:grid-cols-2">
            {rest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="border-y border-gold/15 bg-paper-2">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <p class="eyebrow">Why this exists</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl font-medium tracking-tight text-ink">
        Why trust Selected by Men
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          reasons.map((reason, index) => (
            <article>
              <p class="font-serif text-2xl text-gold">0{index + 1}</p>
              <h3 class="mt-4 font-serif text-2xl font-medium tracking-tight text-ink">{reason.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{reason.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8">
    <p class="eyebrow">Ready when you are</p>
    <h2 class="mt-4 font-serif text-4xl font-medium tracking-tight text-ink sm:text-5xl">
      Stop collecting tabs. Start with a short list.
    </h2>
    <p class="mx-auto mt-5 max-w-lg text-ink-soft">
      New guides land when we have something worth recommending — not when a
      calendar says so.
    </p>
    <a href="/blog/" class="btn btn-primary mt-8">
      See all recommendations
    </a>
  </section>
</BaseLayout>

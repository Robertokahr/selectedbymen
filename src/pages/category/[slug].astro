---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/categories';
import { categoryImageSrc } from '../../data/categoryImages';
import { getPostsByCategory } from '../../lib/posts';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
const imageSrc = categoryImageSrc(category.slug);
const empty = posts.length === 0;
---

<BaseLayout
  title={category.seoTitle}
  description={category.description}
  noindex={empty}
>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14 sm:px-8 sm:pt-20">
    <p class="font-serif text-2xl text-gold">{category.number}</p>
    <h1 class="mt-3 font-serif text-5xl font-medium tracking-tight text-ink sm:text-6xl">
      {category.title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
      {category.description}
    </p>
    <img
      src={imageSrc}
      alt={`${category.title} editorial still life`}
      width="1400"
      height="600"
      class="mt-10 aspect-[21/9] w-full border border-gold/15 object-cover"
      decoding="async"
    />
    <div class="mt-8 flex flex-wrap gap-2">
      <a
        href="/blog/"
        class="border border-gold/25 px-4 py-2 text-xs font-medium uppercase tracking-[0.14em] text-ink-soft hover:text-gold"
      >
        All
      </a>
      {
        categories.map((item) => (
          <a
            href={`/category/${item.slug}/`}
            class:list={[
              'px-4 py-2 text-xs font-medium uppercase tracking-[0.14em]',
              item.slug === category.slug
                ? 'bg-burgundy text-cream'
                : 'border border-gold/25 text-ink-soft hover:text-gold',
            ]}
          >
            {item.title}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    {
      posts.length > 0 ? (
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-gold/25 bg-paper-2 px-8 py-16 text-center">
          <h2 class="font-serif text-3xl font-medium text-ink">Guides in progress</h2>
          <p class="mx-auto mt-3 max-w-md text-muted">
            We have not published a {category.title.toLowerCase()} recommendation yet.
            Check back soon, or browse what is live.
          </p>
          <a href="/blog/" class="btn btn-primary mt-6">
            See live recommendations
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>

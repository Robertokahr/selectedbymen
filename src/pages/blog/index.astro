---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/categories';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Buying guides and product recommendations"
  description="Every Selected by Men buying guide: grooming routines, capsule wardrobes, everyday carry tech, and Amazon picks for fitness, home, and daily life."
>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">The archive</p>
    <h1 class="mt-4 font-serif text-5xl font-medium tracking-tight text-ink sm:text-6xl">
      All recommendations
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Guides written to help you buy once and buy well. Filter by category or
      start with whatever is newest.
    </p>
    <div class="mt-8 flex flex-wrap gap-2">
      <a
        href="/blog/"
        class="bg-burgundy px-4 py-2 text-xs font-medium uppercase tracking-[0.14em] text-cream"
      >
        All
      </a>
      {
        categories.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            class="border border-gold/25 px-4 py-2 text-xs font-medium uppercase tracking-[0.14em] text-ink-soft transition hover:border-gold hover:text-gold"
          >
            {category.title}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
